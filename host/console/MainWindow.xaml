<Window x:Class="AegisSoft.AegisDisplay.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="aegisDisplay Console — aegisSoft"
        Icon="Assets/aegisdisplay.ico"
        Width="980"
        Height="780"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48" CornerRadius="12" Background="#14071322" BorderBrush="#4422D3EE" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center" Padding="4">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="512" Height="512">
                            <Path StrokeThickness="18" StrokeLineJoin="Round">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0B192C" Offset="0"/>
                                        <GradientStop Color="#040912" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                                <Path.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#22D3EE" Offset="0"/>
                                        <GradientStop Color="#0284C7" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Stroke>
                                <Path.Data>M256,30 L452,118 L452,254 C452,366 364,444 256,482 C148,444 60,366 60,254 L60,118 Z</Path.Data>
                            </Path>
                            <Rectangle Canvas.Left="114" Canvas.Top="148" Width="248" Height="168" RadiusX="18" RadiusY="18" Fill="#0E223A" Stroke="#38BDF8" StrokeThickness="14"/>
                            <Path Fill="#0EA5E9" Data="M214,316 H262 L270,342 H206 Z"/>
                            <Rectangle Canvas.Left="184" Canvas.Top="342" Width="108" Height="14" RadiusX="6" RadiusY="6" Fill="#38BDF8"/>
                            <Rectangle Canvas.Left="286" Canvas.Top="206" Width="114" Height="176" RadiusX="20" RadiusY="20" Fill="#06101D" Stroke="#67E8F9" StrokeThickness="13"/>
                            <Path Fill="#FFFFFF" Data="M202,254 L258,212 L248,248 L294,248 L238,296 L248,260 Z"/>
                        </Canvas>
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="aegisDisplay Console" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="aegisSoft Low-Latency Virtual Display · SudoVDA + NVENC Direct + USB ADB Tunnel"
                               Opacity="0.72" FontSize="12.5" Margin="0,3,0,0"/>
                </StackPanel>

                <Border x:Name="StateBadge" Grid.Column="2" CornerRadius="16" Padding="14,6" VerticalAlignment="Center"
                        Background="#2294A3B8" BorderBrush="#4494A3B8" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#FF94A3B8" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StateBadgeText" Text="BAĞLANIYOR" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Summary Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource CardSurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="DONANIM VE ENCODER" FontSize="11" Opacity="0.6" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="GpuText" Text="-" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="EncoderText" Text="-" FontSize="12.5" Opacity="0.8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource CardSurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="SANAL MONİTÖR (SUDOVDA)" FontSize="11" Opacity="0.6" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="DriverStatusText" Text="Kontrol ediliyor..." FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VirtualDisplayText" Text="Sanal monitör pasif" FontSize="12.5" Opacity="0.8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="{StaticResource CardSurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="AKTİF İSTEMCİ" FontSize="11" Opacity="0.6" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="ClientNameText" Text="Bekleniyor" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ClientEndpointText" Text="UDP 28450 / TCP 28451" FontSize="12.5" Opacity="0.8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Live Telemetry Strip -->
            <Border Grid.Row="2" Background="{StaticResource CardSurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CANLI FPS" FontSize="11" Opacity="0.6" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FpsText" Text="0.0" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ENCODE SÜRESİ" FontSize="11" Opacity="0.6" FontWeight="SemiBold"/>
                        <TextBlock x:Name="EncodeMsText" Text="0.0 ms" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="AĞ RTT" FontSize="11" Opacity="0.6" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RttMsText" Text="0.0 ms" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="PAKET KAYBI" FontSize="11" Opacity="0.6" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LossText" Text="0.0 ‰" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="DÜŞEN KARE" FontSize="11" Opacity="0.6" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FramesDroppedText" Text="0" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5">
                        <TextBlock Text="HEDEF BİT" FontSize="11" Opacity="0.6" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ActiveBitrateText" Text="22 Mbps" FontSize="17" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="ÇÖZÜNÜRLÜK" FontSize="11" Opacity="0.6" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ResolutionText" Text="-" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quality & Bitrate Controls -->
            <Border Grid.Row="3" Background="{StaticResource CardSurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="KALİTE PROFİLİ VE ANLIK BİT HIZI" FontSize="11" Opacity="0.6" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BitrateValueText" Text="22 Mbps" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <Slider x:Name="BitrateSlider" Minimum="4000" Maximum="60000" Value="22000" TickFrequency="2000" IsSnapToTickEnabled="True"
                            ValueChanged="BitrateSlider_ValueChanged" Margin="0,0,0,12"/>

                    <WrapPanel>
                        <Button Content="Düşük Gecikme (12 Mbps)" Click="PresetLowLatency_Click" Padding="14,7" Margin="0,0,8,8"/>
                        <Button Content="Dengeli (22 Mbps)" Click="PresetBalanced_Click" Padding="14,7" Margin="0,0,8,8"/>
                        <Button Content="Stüdyo Kalite (45 Mbps)" Click="PresetStudio_Click" Padding="14,7" Margin="0,0,8,8"/>
                        <Button Content="Anlık Bit Hızı Uygula" Click="ApplyBitrate_Click" Padding="14,7" Margin="0,0,8,8"/>
                        <Button x:Name="KeyframeBtn" Content="IDR Keyframe Gönder" Click="SendKeyframe_Click" Padding="14,7" Margin="0,0,8,8"/>
                        <Button x:Name="DisconnectBtn" Content="İstemciyi Ayır" Click="DisconnectClient_Click" Padding="14,7" Margin="0,0,0,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Advanced Host & Encoder Settings -->
            <Border Grid.Row="4" Background="{StaticResource CardSurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="GELİŞMİŞ SUNUCU, İMLEÇ VE ENCODER AYARLARI" FontSize="11" Opacity="0.6" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Content="Core'dan Yenile" Click="SyncSettings_Click" Padding="12,5" Margin="0,0,8,0"/>
                            <Button x:Name="ApplySettingsBtn" Content="Ayarları Uygula ve Kaydet" Click="ApplySettings_Click" Padding="14,5"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Rate Control" FontSize="11.5" Opacity="0.78" Margin="0,0,0,4"/>
                            <ComboBox x:Name="RateControlCombo" SelectionChanged="SettingControl_Changed" SelectedIndex="0">
                                <ComboBoxItem Tag="VBR" Content="VBR (Akıllı Tepe 1.35x)"/>
                                <ComboBoxItem Tag="CBR" Content="CBR (Sabit Bit Hızı)"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="NVENC Kalite / Hız Preset" FontSize="11.5" Opacity="0.78" Margin="0,0,0,4"/>
                            <ComboBox x:Name="PresetCombo" SelectionChanged="SettingControl_Changed" SelectedIndex="1">
                                <ComboBoxItem Tag="1" Content="P1 — En Hızlı (Ultra Low Latency)"/>
                                <ComboBoxItem Tag="2" Content="P2 — Hızlı (Önerilen)"/>
                                <ComboBoxItem Tag="3" Content="P3 — Dengeli"/>
                                <ComboBoxItem Tag="4" Content="P4 — Yüksek Kalite"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Video Kodek Zorlama" FontSize="11.5" Opacity="0.78" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CodecCombo" SelectionChanged="SettingControl_Changed" SelectedIndex="0">
                                <ComboBoxItem Tag="AUTO" Content="Otomatik (HEVC Tercihli)"/>
                                <ComboBoxItem Tag="HEVC" Content="HEVC (H.265) Zorla"/>
                                <ComboBoxItem Tag="H264" Content="H.264 Zorla"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Maksimum FPS Sınırı" FontSize="11.5" Opacity="0.78" Margin="0,0,0,4"/>
                            <ComboBox x:Name="MaxFpsCombo" SelectionChanged="SettingControl_Changed" SelectedIndex="3">
                                <ComboBoxItem Tag="30" Content="30 FPS"/>
                                <ComboBoxItem Tag="60" Content="60 FPS"/>
                                <ComboBoxItem Tag="90" Content="90 FPS"/>
                                <ComboBoxItem Tag="120" Content="120 FPS"/>
                                <ComboBoxItem Tag="240" Content="240 FPS"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="IDR Keyframe Periyodu" FontSize="11.5" Opacity="0.78" Margin="0,0,0,4"/>
                            <ComboBox x:Name="IdrIntervalCombo" SelectionChanged="SettingControl_Changed" SelectedIndex="1">
                                <ComboBoxItem Tag="1" Content="1 sn (En Hızlı Toparlanma)"/>
                                <ComboBoxItem Tag="2" Content="2 sn (Önerilen)"/>
                                <ComboBoxItem Tag="3" Content="3 sn"/>
                                <ComboBoxItem Tag="5" Content="5 sn"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sanal Monitör Konumu" FontSize="11.5" Opacity="0.78" Margin="0,0,0,4"/>
                            <ComboBox x:Name="PlacementCombo" SelectionChanged="SettingControl_Changed" SelectedIndex="0">
                                <ComboBoxItem Tag="RIGHT" Content="Ana Ekranın Sağı (RIGHT)"/>
                                <ComboBoxItem Tag="LEFT" Content="Ana Ekranın Solu (LEFT)"/>
                                <ComboBoxItem Tag="TOP" Content="Ana Ekranın Üstü (TOP)"/>
                                <ComboBoxItem Tag="BOTTOM" Content="Ana Ekranın Altı (BOTTOM)"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="UDP Paket Boyutu (MTU)" FontSize="11.5" Opacity="0.78" Margin="0,0,0,4"/>
                            <ComboBox x:Name="UdpPayloadCombo" SelectionChanged="SettingControl_Changed" SelectedIndex="1">
                                <ComboBoxItem Tag="1024" Content="1024 Bayt (VPN/Wi-Fi Güvenli)"/>
                                <ComboBoxItem Tag="1280" Content="1280 Bayt (Önerilen Standart)"/>
                                <ComboBoxItem Tag="1360" Content="1360 Bayt (Yüksek Verim)"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Text="Ayarlar AppData JSON'a kalıcı yazılır" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel>
                        <CheckBox x:Name="CursorCheck" Content="Fare İmleci Yakalama (DXGI + GDI Yedek)" IsChecked="True"
                                  Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" Margin="0,0,22,4"/>
                        <CheckBox x:Name="UdpPacingCheck" Content="UDP Burst Pacing (Yırtılma Önleyici)" IsChecked="True"
                                  Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" Margin="0,0,22,4"/>
                        <CheckBox x:Name="IntraRefreshCheck" Content="Periodic Intra-Refresh (GOP Yerine)" IsChecked="False"
                                  Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" Margin="0,0,0,4"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- System & USB ADB Actions -->
            <Border Grid.Row="5" Background="{StaticResource CardSurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="SİSTEM, USB TÜNEL VE SÜRÜCÜ YÖNETİMİ" FontSize="11" Opacity="0.6" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Button Content="USB ADB Tüneli Kur (28451)" Click="SetupAdb_Click" Padding="14,8" Margin="0,0,8,8"/>
                        <Button Content="SudoVDA Sürücüsünü Kur (UAC)" Click="InstallDriver_Click" Padding="14,8" Margin="0,0,8,8"/>
                        <Button Content="SudoVDA Sürücüsünü Kaldır (UAC)" Click="UninstallDriver_Click" Padding="14,8" Margin="0,0,8,8"/>
                        <Button Content="Windows Ekran Ayarları" Click="OpenDisplaySettings_Click" Padding="14,8" Margin="0,0,8,8"/>
                        <Button Content="Core Motorunu Başlat" Click="StartCore_Click" Padding="14,8" Margin="0,0,8,8"/>
                        <Button Content="Sistem Tepsisine Küçült" Click="HideToTray_Click" Padding="14,8" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="ActionLogText" Text="Hazır." FontSize="12" Opacity="0.8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
