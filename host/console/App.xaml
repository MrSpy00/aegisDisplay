<Application x:Class="AegisSoft.AegisDisplay.Console.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="CardSurfaceBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#28FFFFFF"/>
        <SolidColorBrush x:Key="AccentTealBrush" Color="#FF00B8D4"/>
        <SolidColorBrush x:Key="StatusGoodBrush" Color="#FF22C55E"/>
        <SolidColorBrush x:Key="StatusWarnBrush" Color="#FFF59E0B"/>
        <SolidColorBrush x:Key="StatusOfflineBrush" Color="#FF94A3B8"/>
    </Application.Resources>
</Application>
